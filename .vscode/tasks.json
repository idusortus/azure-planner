{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-agent",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/BudgetFriendlyAzureAdvisor/BudgetFriendlyAzureAdvisor.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "run-agent",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/BudgetFriendlyAzureAdvisor/BudgetFriendlyAzureAdvisor.csproj"
      ],
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}/src/BudgetFriendlyAzureAdvisor"
      },
      "isBackground": true
    },
    {
      "label": "restore-agent",
      "command": "dotnet",
      "type": "process",
      "args": [
        "restore",
        "${workspaceFolder}/src/BudgetFriendlyAzureAdvisor/BudgetFriendlyAzureAdvisor.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Terminate All Tasks",
      "command": "echo ${input:terminate}",
      "type": "shell",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "terminate",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "terminateAll"
    }
  ]
}
